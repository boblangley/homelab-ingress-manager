# Base Caddyfile for caddy-security. Mounted into the ingress container and
# loaded with CADDY_DOCKER_CADDYFILE_PATH. It only holds the global security
# block; the portal and protected sites come from container labels.
# OIDC_CLIENT_ID and OIDC_CLIENT_SECRET come from the ingress environment.
{
	security {
		oauth identity provider generic {
			realm generic
			driver generic
			client_id {env.OIDC_CLIENT_ID}
			client_secret {env.OIDC_CLIENT_SECRET}
			scopes openid email profile
			base_auth_url https://idp.example.com
			metadata_url https://idp.example.com/.well-known/openid-configuration
		}

		authentication portal myportal {
			crypto default token lifetime 3600
			enable identity provider generic
			cookie domain home.arpa
			transform user {
				match realm generic
				action add role authp/user
			}
		}

		authorization policy users {
			set auth url https://auth.home.arpa/oauth2/generic
			allow roles authp/user
		}
	}
}
