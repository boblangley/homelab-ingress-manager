OPNSENSE_URL=https://192.168.1.1
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
# OPNsense ships with a self-signed certificate.
OPNSENSE_INSECURE_SKIP_VERIFY=true
INGRESS_HOST_IP=192.168.1.10

# Optional: read secrets from Vault/OpenBao. Any variable can be a
# vault:<path>#<field> reference, e.g.
#   OPNSENSE_API_SECRET=vault:secret/data/opnsense#api_secret
# VAULT_ADDR=https://vault.home.arpa:8200   # or unix:///path/to/vault.sock
# VAULT_TOKEN=
